const categories = [
  { label: 'All',         value: 'all' },
  { label: 'Restoration', value: 'restoration' },
  { label: 'Build',       value: 'build' },
  { label: 'Paint',       value: 'paint' },
  { label: 'Body Work',   value: 'body' },
  { label: 'Repair',      value: 'repair' },
];

// Resolve file names to optimized ImageMetadata for rendering.
const resolve = (p: RawProject) => ({
  ...p,
  coverImg: img(p.cover),
  images: p.images.map((im) => ({ ...im, meta: img(im.file) })),
});

const featuredResolved = featured.map(resolve);
const projectsResolved = projects.map(resolve);

// Pre-generate optimized (webp, ~1600px) URLs for the lightbox and hand them to
// the client script as JSON — the full-size originals are never shipped to the browser.
const lightboxData: Record<string, { src: string; caption: string }[]> = {};
for (const p of [...featuredResolved, ...projectsResolved]) {
  lightboxData[p.id] = await Promise.all(
    p.images.map(async (im) => ({
      src: (await getImage({ src: im.meta, width: 1600, format: 'webp' })).src,
      caption: im.caption,
    })),
  );
}
