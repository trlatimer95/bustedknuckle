          ]}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Featured Projects (large cards) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
      {featuredResolved.map((project) => (
        <div data-category={project.category} class="portfolio-item group">
          <div
