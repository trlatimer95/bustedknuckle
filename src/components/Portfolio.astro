import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Eagerly import every portfolio image so Astro optimizes them (resize + webp) at build time.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portfolio/**/*.{jpg,jpeg,JPG,JPEG}',
  { eager: true },
);

// Resolve an image by its file name (base names are unique across the folder).
const img = (name: string): ImageMetadata => {
  const entry = Object.entries(modules).find(([path]) => path.endsWith('/' + name));
  if (!entry) throw new Error(`Portfolio image not found: ${name}`);
  return entry[1].default;
};

interface RawProject {
  id: string;
  title: string;
  category: string;
  description: string;
  cover: string;
  images: { file: string; caption: string }[];
